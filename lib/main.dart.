import 'package:flutter/material.dart';

void main() {
  runApp(const AliyansTailoringApp());
}

const Color emerald = Color(0xFF064E3B);
const Color green = Color(0xFF047857);
const Color gold = Color(0xFFD4AF37);
const Color pageBackground = Color(0xFFF4F7F5);

class AliyansTailoringApp extends StatelessWidget {
  const AliyansTailoringApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: 'Aliyans Tailoring Manager',
      debugShowCheckedModeBanner: false,
      theme: ThemeData(
        useMaterial3: true,
        scaffoldBackgroundColor: pageBackground,
        colorScheme: ColorScheme.fromSeed(seedColor: emerald),
        appBarTheme: const AppBarTheme(
          backgroundColor: emerald,
          foregroundColor: Colors.white,
        ),
      ),
      home: const DashboardPage(),
    );
  }
}

