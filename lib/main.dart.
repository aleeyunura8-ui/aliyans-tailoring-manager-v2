                          ),
                        ),
                      ),
                    ],
                  ),
                  SizedBox(height: 12),
                  Text(
                    'Jega, Kebbi State, Nigeria',
                    style: TextStyle(color: Colors.white70),
                  ),
                  SizedBox(height: 10),
                  Text(
                    'TAILORING MANAGER',
                    style: TextStyle(
                      color: gold,
                      fontSize: 14,
                      fontWeight: FontWeight.bold,
                      letterSpacing: 2,
